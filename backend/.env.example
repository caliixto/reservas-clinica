# MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/reservas-clinica

# Frontend (para CORS y para volver desde Stripe)
FRONTEND_URL=http://localhost:4200

# Secreto para firmar los tokens del panel
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria

# Stripe. Si STRIPE_SECRET_KEY está vacío, la app funciona en MODO DEMO (pago simulado).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (subida de logos). Opcional: sin esto no se pueden subir logos.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (lo encuentras en tu panel de Cloudinary)
CLOUDINARY_URL=

# Email (confirmaciones a pacientes y avisos a la clínica). Opcional: sin esto, los emails se muestran en la consola.
# Con Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación" (no uses tu contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente que verá el paciente, por ejemplo: Reservas AMP FISIO <tucorreo@gmail.com>
MAIL_FROM=
